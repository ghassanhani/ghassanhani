{
  "expo": {
    "name": "المكنون",
    "slug": "maknoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.maknoon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستمع المكنون إلى تلاوتك للتسميع فقط. يُعالَج الصوت على جهازك ولا يُحفظ ولا يُرسل.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#035A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.maknoon",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 194,
          "resizeMode": "contain",
          "backgroundColor": "#075B5F"
        }
      ],
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم المكنون بوصلة الهاتف ليريك اتجاه القبلة. يبقى ذلك على جهازك ولا يُرسل إلى أي مكان.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-image",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "يستمع المكنون إلى تلاوتك للتسميع فقط. يُعالَج الصوت على جهازك ولا يُحفظ ولا يُرسل."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يستمع المكنون إلى تلاوتك للتسميع فقط. يُعالَج الصوت على جهازك ولا يُحفظ ولا يُرسل.",
          "speechRecognitionPermission": "يتعرّف المكنون على كلمات تلاوتك على جهازك فقط ليُظهرها أثناء التسميع. لا يُرسل الصوت ولا يُحفظ.",
          "androidSpeechServicePackages": [
            "com.google.android.as"
          ]
        }
      ]
    ],
    "scheme": "maknoon",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "packsBaseUrl": null,
      "searchWorkerUrl": "https://maknoon-assistant.ghassanhani0.workers.dev",
      "modelBaseUrl": "https://raw.githubusercontent.com/ghassanhani/ghassanhani/eb53332ceeadc62f921551ba2c1decf5d5a6a941/maknoon/hosted/models",
      "eas": {
        "projectId": "efb5e217-ad97-4247-9609-b990594f8834"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "ghassanhani0"
  }
}
