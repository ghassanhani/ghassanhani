{
  "expo": {
    "name": "المكنون",
    "slug": "maknoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.maknoon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستمع المكنون إلى تلاوتك للتسميع فقط. يُعالَج الصوت على جهازك ولا يُحفظ ولا يُرسل.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#035A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.maknoon",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#035A5F"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-image",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "يستمع المكنون إلى تلاوتك للتسميع فقط. يُعالَج الصوت على جهازك ولا يُحفظ ولا يُرسل."
        }
      ]
    ],
    "scheme": "maknoon",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "packsBaseUrl": null,
      "searchWorkerUrl": "https://maknoon-assistant.ghassanhani0.workers.dev",
      "modelBaseUrl": "https://raw.githubusercontent.com/ghassanhani/ghassanhani/eb53332ceeadc62f921551ba2c1decf5d5a6a941/maknoon/hosted/models"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
