{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "whisper.rn/*": [
        "./node_modules/whisper.rn/lib/typescript/*"
      ]
    }
  },
  "exclude": [
    "server/**",
    "scripts/**",
    "tests/**",
    "pipeline/**",
    "node_modules"
  ]
}
