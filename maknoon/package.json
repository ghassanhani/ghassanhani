    "react-native-worklets": "0.13.0",
    "whisper.rn": "^0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fontkit": "2.0.4",
    "hyparquet": "^1.33.0",
    "quran-qcf4": "1.1.0",
    "typescript": "~6.0.3",
    "wawoff2": "2.0.1"
