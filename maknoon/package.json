  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "fetch:quran": "NODE_USE_ENV_PROXY=1 node pipeline/importers/tanzil/import.mjs --download",
    "fonts:link": "node scripts/link-fonts.mjs",
    "sync:ratq": "NODE_USE_ENV_PROXY=1 node scripts/sync-ratq.mjs",
    "itqan:pull": "NODE_USE_ENV_PROXY=1 node pipeline/importers/ratq/pull.mjs",
    "content:build": "node scripts/build-content.mjs",
    "packs:build": "node --no-warnings pipeline/importers/ratq/import.mjs",
    "search:build": "node --no-warnings --experimental-strip-types scripts/build-search.mts",
    "embeddings:build": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/build-embeddings.mjs",
    "lint": "eslint .",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mts",
    "search:eval": "NODE_USE_ENV_PROXY=1 node --no-warnings --experimental-strip-types tests/eval-hybrid.mts",
    "check": "npm run typecheck && npm run lint && npm test",
    "import:tanzil": "node pipeline/importers/tanzil/import.mjs",
    "import:ratq": "node --no-warnings pipeline/importers/ratq/import.mjs",
    "recitation:eval": "node --no-warnings --experimental-strip-types pipeline/recitation-eval/score.mts",
    "fonts:qcf4": "node --no-warnings --max-old-space-size=3072 pipeline/importers/qcf4/import.mjs",
    "postinstall": "node --no-warnings --max-old-space-size=3072 pipeline/importers/qcf4/import.mjs --if-needed",
    "hadith:pull": "NODE_USE_ENV_PROXY=1 node pipeline/importers/sunnah/pull.mjs",
    "hadith:build": "node --no-warnings --max-old-space-size=3072 pipeline/importers/sunnah/import.mjs"
  },
  "private": true
}
